const mongoose = require("mongoose");

const recordSchema = new mongoose.Schema(
    {
	studyDate: {
	    type: String,
	},
	questionTitle: {
	    type: String,
	    required: true,
	},
	questionUrl: {
	    type: String,
	},
	difficulty: {
	    type: Number,
	},
	tags: {
	    type: [String],
	    default: [],
	},
	status: {
	    type: String,
	    enum: ["","solved", "review", "unsolved"],
	    default: "",
	}
	memo: {
	    type: String,
	},
    },
    {
	timestamps: true,
    }
);

module.exports = mongoose.model("Record", recordSchema);
